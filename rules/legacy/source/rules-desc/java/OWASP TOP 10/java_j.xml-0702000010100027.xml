<?xml version='1.0' encoding='utf-8'?>
<BugInfo xmlns="http://www.codesafe.cn/schema/rules" id="0702000010100027" language="Java">
			<Type>bug</Type>
			<Categories>
				<Category type="ClassChin">OWASP TOP 10</Category>
				<Category type="SubClassChin">配置管理</Category>
				<Category type="DetailClassChin">Struts配置错误：缺少form-bean标签的type属性</Category>
			</Categories>
			<BugServerity>1</BugServerity>
			<DynamicDescription><![CDATA[<p th:text="在+'`'+${fileName}+'`'+的第+'`'+${line}+'`'+行的form-bean标签缺少type属性。" th:remove="tag"></p>]]></DynamicDescription>
			<Description><![CDATA[struts使用form-bean标签将HTML形式映射至操作，如果`<action>`标签中缺少type属性，则其不能映射到一个操作。  
  
**例如**：如下form-bean标签未指定type属性值
```xml
<form-bean name="loginForm" type="">  
    <form-property name="favoriteColor" type="java.lang.String" />  
</form-bean>
```  
]]></Description>
			<Advice><![CDATA[检查程序逻辑，增加type属性。
]]></Advice>
			<References>
				<Reference type="OWASP TOP 10">2017:A6 Security Misconfiguration</Reference>
				<Reference type="OWASP TOP 10">2013:A5 Security Misconfiguration</Reference>
			</References>
			<Obsolete>not</Obsolete>
			<Default>not</Default>
			<WhiteList>not</WhiteList>
			<Security>not</Security>



			<Tag>correctness</Tag>
			<DomainType>bug</DomainType>
		</BugInfo>
		