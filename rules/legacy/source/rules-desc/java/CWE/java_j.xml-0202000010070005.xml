<?xml version='1.0' encoding='utf-8'?>
<BugInfo xmlns="http://www.codesafe.cn/schema/rules" id="0202000010070005" language="Java">
			<Type>bug</Type>
			<Categories>
				<Category type="ClassChin">CWE</Category>
				<Category type="SubClassChin">API误用</Category>
				<Category type="DetailClassChin">负的Content-Length</Category>
			</Categories>
			<BugServerity>2</BugServerity>
			<DynamicDescription><![CDATA[<p th:if="${funcNameisEmpty}" th:text="在+'`'+${fileName}+'`'+的+'`'+${funcName}+'`'+方法中的第+'`'+${line}+'`'+行设置了负的Content-Length。" th:remove="tag"></p>
<p th:unless="${funcNameisEmpty}" th:text="在+'`'+${fileName}+'`'+的第+'`'+${line}+'`'+行设置了负的Content-Length。" th:remove="tag"></p>]]></DynamicDescription>
			<Description><![CDATA[`Content-Length`用于描述HTTP消息实体的传输长度。正常情况下该值应该为0或正整数。  
  
**例如**：以下代码设置的`Content-Length`的值是不正确的。  
```java
URL url = new URL("http://www.codesafe.com");  
HttpURLConnection urlconnection= (HttpURLConnection)url.openConnection();  
urlconnection.setRequestProperty("Content-Length", "-1024");
```
]]></Description>
			<Advice><![CDATA[检查程序逻辑，重置`Content-Length`的值。
]]></Advice>
			<References>
				<Reference type="CWE">398:Indicator of Poor Code Quality</Reference>
			</References>
			<Obsolete>not</Obsolete>
			<Default>yes</Default>
			<WhiteList>not</WhiteList>
			<Security>not</Security>



			<Tag>correctness</Tag>
			<DomainType>bug</DomainType>
		</BugInfo>
		