<BugInfo xmlns="http://www.codesafe.cn/schema/rules" id="0202000010130011" language="Java">
			<Type>bug</Type>
			<Categories>
				<Category type="ClassChin">CWE</Category>
				<Category type="SubClassChin">代码质量</Category>
				<Category type="DetailClassChin">变量和方法同名</Category>
			</Categories>
			<BugServerity>1</BugServerity>
			<DynamicDescription><![CDATA[<p th:if="${funcNameisEmpty}" th:text="在+'`'+${fileName}+'`'+的+'`'+${funcName}+'`'+方法中的第+'`'+${line}+'`'+行定义的变量和方法同名。" th:remove="tag"></p>
<p th:unless="${funcNameisEmpty}" th:text="在+'`'+${fileName}+'`'+的第+'`'+${line}+'`'+行定义的变量和方法同名。" th:remove="tag"></p>]]></DynamicDescription>
			<Description><![CDATA[变量与方法同名，容易导致程序混乱或产生错误的代码。  
  
**例如**：下列代码中，变量与方法同名  
```java
...  
private String bad;   
public static void bad() {  
    ...  
}  
...
```
]]></Description>
			<Advice><![CDATA[不要使用容易造成混淆的命名。
]]></Advice>
			<References>
				<Reference type="CWE">398:Indicator of Poor Code Quality</Reference>
			</References>
			<Obsolete>not</Obsolete>
			<Default>yes</Default>
			<WhiteList>not</WhiteList>
			<Security>not</Security>



