<?xml version='1.0' encoding='utf-8'?>
<BugInfo xmlns="http://www.codesafe.cn/schema/rules" id="0202000010130112" language="Java">
			<Type>bug</Type>
			<Categories>
				<Category type="ClassChin">CWE</Category>
				<Category type="SubClassChin">代码质量</Category>
				<Category type="DetailClassChin">switch语句中缺少default语句</Category>
			</Categories>
			<BugServerity>1</BugServerity>
			<DynamicDescription><![CDATA[<p th:if="${funcNameisEmpty}" th:text="在+'`'+${fileName}+'`'+的+'`'+${funcName}+'`'+方法中的第+'`'+${line}+'`'+行switch语句中缺少default语句。" th:remove="tag"></p>
<p th:unless="${funcNameisEmpty}" th:text="在+'`'+${fileName}+'`'+的第+'`'+${line}+'`'+行所在switch语句中缺少default语句。" th:remove="tag"></p>]]></DynamicDescription>
			<Description><![CDATA[程序中switch语句缺少default语句，而所有可能的变量值不一定都会被给定的case语句处理，导致一些情况未处理并产生问题。
]]></Description>
			<Advice><![CDATA[检查程序逻辑，为switch语句添加所需的default语句
]]></Advice>
			<References>
				<Reference type="CWE">478:Missing Default Case in Switch Statement</Reference>
				<Reference type="CWE">398:Indicator of Poor Code Quality</Reference>
			</References>
			<Obsolete>not</Obsolete>
			<Default>not</Default>
			<WhiteList>not</WhiteList>
			<Security>not</Security>



			<Tag>bad_practice</Tag>
			<DomainType>quality</DomainType>
		</BugInfo>
		