<?xml version='1.0' encoding='utf-8'?>
<BugInfo xmlns="http://www.codesafe.cn/schema/rules" id="0202000010110015" language="Java">
			<Type>bug</Type>
			<Categories>
				<Category type="ClassChin">CWE</Category>
				<Category type="SubClassChin">代码质量</Category>
				<Category type="DetailClassChin">Struts2：校验文件没有对应的Action</Category>
			</Categories>
			<BugServerity>1</BugServerity>
			<DynamicDescription><![CDATA[<p th:text="在+'`'+${fileName}+'`'+的第+'`'+${line}+'`'+行中Action没有对应的校验文件。" th:remove="tag"></p>]]></DynamicDescription>
			<Description><![CDATA[struts2校验文件没有对应的Action，对于每个ActionClass，Struts2都会搜索对应的`ActionClass-validation.xml`，以获取必要的验证限制。当开发人员删除或者重命名Action表单映射后，很容易忘记更新验证逻辑。如果缺少校验器定义，就表明验证逻辑没有得到适当维护。
]]></Description>
			<Advice><![CDATA[使用ActionClass和`validation.xml`形式的校验文件时，ActionClass与Struts2配置文件中定义的功能要相互匹配。
]]></Advice>
			<References>
				<Reference type="CWE">101:Struts Validation Problems</Reference>
				<Reference type="OWASP TOP 10">2017:A6 Security Misconfiguration</Reference>
				<Reference type="OWASP TOP 10">2013:A5 Security Misconfiguration</Reference>
				<Reference type="OWASP TOP 10">2010:A6 Security Misconfiguration</Reference>
				<Reference type="OWASP TOP 10">2004:A10 Insecure Configuration Management</Reference>
			</References>
			<Obsolete>not</Obsolete>
			<Default>not</Default>
			<WhiteList>not</WhiteList>
			<Security>yes</Security>



			<Tag>security,correctness</Tag>
			<DomainType>security</DomainType>
		</BugInfo>
		