ModelQuery(
  name="get_platform_functions_sources",
  find="functions",
  where=[
    AnyOf(
      name.matches("^platform.*\.version$"),
      name.matches("^platform.*\.processor$"),
      name.matches("^platform.*\.mac_ver$"),
      name.matches("^platform.*\.release$"),
      name.matches("^platform.*\.uname$"),
      name.matches("^platform.*\.architecture$"),
      name.matches("^platform.*\.node$"),
      name.matches("^platform.*\.system(_alias)?"),
      name.matches("^platform.*\.(python_(build|compiler|branch|implementation|revision|version|version_tuple))"),
      name.matches("^platform.*\.((libc|java)_ver)"),
      name.matches("^platform.*\.platform$"),
      name.matches("^platform.*\.machine$"),
      name.matches("^platform.*\.(win32_(ver|edition|is_iot))")
    )
  ],
  model=[
    Returns(TaintSource[CustomUserControlled]),
  ]
)

