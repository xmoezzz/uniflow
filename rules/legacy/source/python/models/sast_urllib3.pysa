# DataflowSourceRule urllib3 4
# [{'NamespaceName': 'urllib3.connection', 'ClassName': '((Unv|V)erified)?HTTP(S)?Connection', 'FunctionName': 'getresponse', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': 'urllib3.request', 'ClassName': 'RequestMethods', 'FunctionName': 'request(_encode_(url|body))?', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': 'urllib3.connectionpool', 'ClassName': 'HTTP(S)?ConnectionPool', 'FunctionName': 'urlopen', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': 'urllib3.poolmanager', 'ClassName': '(Proxy|Pool)Manager', 'FunctionName': 'urlopen', 'RuleName': 'reserve', 'Origin': 'Fortify'}]
ModelQuery(
  name="get_urllib3_methods_sources",
  find="methods",
  where=[
    AnyOf(
      name.matches("^urllib3\.connectionpool\.HTTP(S)?ConnectionPool\.urlopen$"),
      name.matches("^urllib3\.request\.RequestMethods\.(request(_encode_(url|body))?)"),
      name.matches("^urllib3\.connection\.(((Unv|V)erified)?HTTP(S)?Connection)\.getresponse$"),
      name.matches("^urllib3\.poolmanager\.((Proxy|Pool)Manager)\.urlopen$")
    )
  ],
  model=[
    Returns(TaintSource[CustomUserControlled]),
  ]
)

