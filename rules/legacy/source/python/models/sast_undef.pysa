, 'Origin': 'Fortify'}]
ModelQuery(
  name="get_undef_functions_sinks",
  find="functions",
  where=[
    AnyOf(
      name.matches("execfile$"),
      name.matches("(__import__|reload)"),
      name.matches("pythondict$"),
      name.matches("pythonprint$"),
      name.matches("pythonassert$"),
      name.matches("open$"),
      name.matches("(pythonexec|eval)")
    )
  ],
  model=[
    Parameters(
      TaintSink[sast_unsafe_reflection]
    )
  ]
)


ModelQuery(
  name="get_undef_methods_sinks",
  find="methods",
  where=[
    AnyOf(
      name.matches(".*dict\.__setitem__"),
      name.matches(".*file\.__init__"),
      name.matches(".*file\.(write|writelines)")
    )
  ],
  model=[
