# DataflowSourceRule undef 7
# [{'NamespaceName': '', 'ClassName': '', 'FunctionName': 'django_get_string_url_param', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': '', 'ClassName': '', 'FunctionName': 'django_get_slug_url_param', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': '', 'ClassName': '', 'FunctionName': 'django_get_path_url_param', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': '', 'ClassName': '', 'FunctionName': 'django_get_int_url_param', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': '', 'ClassName': 'file', 'FunctionName': 'read(line|lines)?|xreadlines', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': '', 'ClassName': '', 'FunctionName': 'raw_input|input', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': '', 'ClassName': '', 'FunctionName': 'dir|globals', 'RuleName': 'reserve', 'Origin': 'Fortify'}]
ModelQuery(
  name="get_undef_functions_sources",
  find="functions",
  where=[
    AnyOf(
      name.matches("django_get_path_url_param$"),
      name.matches("django_get_int_url_param$"),
      name.matches("django_get_string_url_param$"),
      name.matches("(raw_input|input)"),
      name.matches("(dir|globals)"),
      name.matches("django_get_slug_url_param$")
    )
  ],
  model=[
    Returns(TaintSource[CustomUserControlled]),
  ]
)


ModelQuery(
  name="get_undef_methods_sources",
  find="methods",
  where=[
    name.matches(".*file\.(read(line|lines)?|xreadlines)")
  ],
  model=[
    Returns(TaintSource[CustomUserControlled]),
  ]
)

