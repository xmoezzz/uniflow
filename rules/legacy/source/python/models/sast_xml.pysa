  model=[
    Returns(TaintSource[CustomUserControlled]),
  ]
)


ModelQuery(
  name="get_xml_methods_sources",
  find="methods",
  where=[
    AnyOf(
      name.matches("^xml\.etree\.(c)?ElementTree\.Element\.itertext$"),
      name.matches("^xml\.etree\.(c)?ElementTree\.(ElementTree|Element)\.findtext$"),
      name.matches("^xml\.etree\.(c)?ElementTree\.ElementTree\.write$"),
      name.matches("^xml\.etree\.(c)?ElementTree\.(ElementTree|Element)\.__init__"),
      name.matches("(xml\.dom\.(minidom|pulldom))\.Document\.writexml$"),
      name.matches("^xml\.dom\.minidom\.(Document|Node)\.(toxml|toprettyxml)")
    )
  ],
  model=[
    Returns(TaintSource[CustomUserControlled]),
  ]
)

