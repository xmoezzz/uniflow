# DataflowSourceRule sys 2
# [{'NamespaceName': 'sys', 'ClassName': '', 'FunctionName': '_current_frames|_getframe|getwindowsversion', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': 'sys', 'ClassName': '', 'FunctionName': 'exc_info', 'RuleName': 'reserve', 'Origin': 'Fortify'}]
ModelQuery(
  name="get_sys_functions_sources",
  find="functions",
  where=[
    AnyOf(
      name.matches("^sys.*\.exc_info$"),
      name.matches("^sys.*\.(_current_frames|_getframe|getwindowsversion)")
    )
  ],
  model=[
    Returns(TaintSource[CustomUserControlled]),
  ]
)

# DataflowSinkRule sys 1
