# DataflowSourceRule MySQLdb 3
# [{'NamespaceName': 'MySQLdb.cursors', 'ClassName': 'CursorStoreResultMixIn|CursorUseResultMixIn', 'FunctionName': 'fetch(one|many|all)', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': 'MySQLdb.cursors', 'ClassName': 'CursorDictRowsMixIn', 'FunctionName': 'fetchoneDict|fetchmanyDict|fetchallDict', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': 'MySQLdb.cursors', 'ClassName': 'BaseCursor', 'FunctionName': '_fetch_row', 'RuleName': 'reserve', 'Origin': 'Fortify'}]
ModelQuery(
  name="get_MySQLdb_methods_sources",
  find="methods",
  where=[
    AnyOf(
      name.matches("^MySQLdb\.cursors\.(CursorStoreResultMixIn|CursorUseResultMixIn)\.(fetch(one|many|all))"),
      name.matches("^MySQLdb\.cursors\.CursorDictRowsMixIn\.(fetchoneDict|fetchmanyDict|fetchallDict)"),
      name.matches("^MySQLdb\.cursors\.BaseCursor\._fetch_row$")
    )
  ],
  model=[
    Returns(TaintSource[CustomUserControlled]),
  ]
)

