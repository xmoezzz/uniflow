# DataflowSourceRule requests 3
# [{'NamespaceName': 'requests.api', 'ClassName': '', 'FunctionName': 'get|put|post|delete|head|options', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': 'requests.sessions', 'ClassName': 'Session', 'FunctionName': 'get|put|post|delete|head|options', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': 'requests.models', 'ClassName': 'Response', 'FunctionName': 'json', 'RuleName': 'reserve', 'Origin': 'Fortify'}]
ModelQuery(
  name="get_requests_functions_sources",
  find="functions",
  where=[
    name.matches("^requests\.api.*\.(get|put|post|delete|head|options)")
  ],
  model=[
    Returns(TaintSource[CustomUserControlled]),
  ]
)


ModelQuery(
  name="get_requests_methods_sources",
  find="methods",
  where=[
    AnyOf(
      name.matches("^requests\.sessions\.Session\.(get|put|post|delete|head|options)"),
      name.matches("^requests\.models\.Response\.json$")
    )
  ],
  model=[
    Returns(TaintSource[CustomUserControlled]),
  ]
)

