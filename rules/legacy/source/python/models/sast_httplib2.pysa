# DataflowSourceRule httplib2 1
# [{'NamespaceName': 'httplib2', 'ClassName': 'Http', 'FunctionName': 'request', 'RuleName': 'reserve', 'Origin': 'Fortify'}]
ModelQuery(
  name="get_httplib2_methods_sources",
  find="methods",
  where=[
    name.matches("^httplib2\.Http\.request$")
  ],
  model=[
    Returns(TaintSource[CustomUserControlled]),
  ]
)

# DataflowSinkRule httplib2 3
# [{'NamespaceName': 'httplib2', 'ClassName': 'Http', 'FunctionName': 'request', 'RuleName': 'desc.dataflow.python.server_side_request_forgery', 'Origin': 'Fortify'}, {'NamespaceName': 'httplib2', 'ClassName': 'Http', 'FunctionName': 'add_credentials', 'RuleName': 'desc.dataflow.python.password_management', 'Origin': 'Fortify'}, {'NamespaceName': 'httplib2', 'ClassName': 'Http', 'FunctionName': 'add_credentials', 'RuleName': 'desc.dataflow.python.password_management_weak_cryptography', 'Origin': 'Fortify'}]
