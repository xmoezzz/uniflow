# DataflowSourceRule urllib 5
# [{'NamespaceName': 'urllib', 'ClassName': '', 'FunctionName': 'urlopen', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': 'urllib', 'ClassName': '', 'FunctionName': 'urlretrieve', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': 'urllib', 'ClassName': 'addinfourl|addbase', 'FunctionName': 'read|readline(s)?|geturl', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': 'urllib', 'ClassName': 'URLopener', 'FunctionName': 'open', 'RuleName': 'reserve', 'Origin': 'Fortify'}, {'NamespaceName': 'urllib', 'ClassName': 'URLopener', 'FunctionName': 'retrieve', 'RuleName': 'reserve', 'Origin': 'Fortify'}]
ModelQuery(
  name="get_urllib_functions_sources",
  find="functions",
  where=[
    AnyOf(
      name.matches("^urllib.*\.urlopen$"),
      name.matches("^urllib.*\.urlretrieve$")
    )
  ],
  model=[
    Returns(TaintSource[CustomUserControlled]),
  ]
)


ModelQuery(
  name="get_urllib_methods_sources",
  find="methods",
  where=[
    AnyOf(
      name.matches("^urllib\.URLopener\.open$"),
      name.matches("^urllib\.(addinfourl|addbase)\.(read|readline(s)?|geturl)"),
      name.matches("^urllib\.URLopener\.retrieve$")
    )
  ],
  model=[
    Returns(TaintSource[CustomUserControlled]),
  ]
)

