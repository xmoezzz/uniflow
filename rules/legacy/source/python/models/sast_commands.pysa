# DataflowSourceRule commands 1
# [{'NamespaceName': 'commands', 'ClassName': '', 'FunctionName': 'getstatusoutput|getoutput', 'RuleName': 'reserve', 'Origin': 'Fortify'}]
ModelQuery(
  name="get_commands_functions_sources",
  find="functions",
  where=[
    name.matches("^commands.*\.(getstatusoutput|getoutput)")
  ],
  model=[
    Returns(TaintSource[CustomUserControlled]),
  ]
)

# DataflowSinkRule commands 1
